{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "environment",
    "criticality",
    "risk_level",
    "recommendation",
    "justification",
    "evidence",
    "model_version",
    "timestamp"
  ],
  "properties": {
    "service": {
      "type": "string",
      "enum": [
        "orders-api",
        "orders-worker"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev"
      ]
    },
    "criticality": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "APPROVE",
        "HUMAN_REVIEW",
        "REJECT"
      ]
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
