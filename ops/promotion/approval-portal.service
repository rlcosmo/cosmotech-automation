[Unit]
Description=CosmoTech authenticated decision-only approval portal
After=network-online.target
Wants=network-online.target
[Service]
User=cosmotech-promotion
Group=cosmotech-promotion
Environment=PYTHONPATH=/opt/cosmotech/promotion/source
ExecStart=/opt/cosmotech/promotion/venv/bin/python -m automation.approval_server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cosmotech-promotion/portal
UMask=0077
MemoryMax=192M
[Install]
WantedBy=multi-user.target
